{
  "name": "recallhsc",
  "version": "2.0.0",
  "private": true,
  "description": "Memorise HSC English essays chunk by chunk. Static site (GitHub Pages); npm is only used for tests and tooling.",
  "license": "UNLICENSED",
  "scripts": {
    "serve": "node tools/serve.cjs 5179",
    "test": "npm run test:unit && npm run test:e2e && npm run test:a11y",
    "test:unit": "node --test \"tests/unit/*.test.cjs\"",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:performance": "node tests/performance/bench.cjs",
    "test:rls": "node tools/rls-check.mjs",
    "stamp": "node tools/stamp-sw.cjs",
    "check:sw": "node tools/stamp-sw.cjs --check",
    "icons": "node tools/make-icons.cjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "1.56.1",
    "@supabase/supabase-js": "2.117.3",
    "axe-core": "4.10.2"
  }
}
